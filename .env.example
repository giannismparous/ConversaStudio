# Shared Gemini key (API only — never expose to the browser)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_DIMS=768

# Default: embedded PGlite (no Docker). For Docker Postgres instead:
# DATABASE_URL=postgresql://forge:forge@127.0.0.1:5433/dialogos_forge
DATABASE_URL=pglite:./data/pglite

# API
API_PORT=8787
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=data/uploads
PUBLIC_API_URL=http://localhost:8787

# Web (Vite)
VITE_API_URL=http://localhost:8787
