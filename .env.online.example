# =============================================================================
# ConversaStudio — ONLINE production env (copy values into hosting dashboards)
# =============================================================================
# Local dev keeps using .env with AUTH_MODE=dev (default). Do not overwrite that.
#
# API host (Render): paste API block into Render → Environment
# Web host (Netlify): paste WEB block into Netlify → Environment variables
# =============================================================================

# --- API (Render / Docker) ---
AUTH_MODE=supabase
STORAGE_MODE=supabase

GEMINI_API_KEY=your_gemini_key_here
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_DIMS=768

# Supabase → Project Settings → Database → Connection string (URI, pooler, port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=conversastudio

API_PORT=8787
API_HOST=0.0.0.0

# Your Netlify URL (no trailing slash)
CORS_ORIGIN=https://your-app.netlify.app

# Your Render API URL (no trailing slash)
PUBLIC_API_URL=https://conversastudio-api.onrender.com

SITE_CRAWL_MAX_PAGES=40

# --- WEB (Netlify) ---
VITE_AUTH_MODE=supabase
VITE_API_URL=https://conversastudio-api.onrender.com
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
